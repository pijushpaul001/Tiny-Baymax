# Copy this file to .env and fill it in. Never commit .env.

# Your Gemini key (server side only; it is never sent to the app).
GEMINI_API_KEY=

# Who may open the app. Format: name=passcode, comma separated.
# Make passcodes long and random:  python -c "import secrets; print(secrets.token_urlsafe(24))"
BAYMAX_TOKENS=

# Model (change here if you switch models). Optional second model if the first keeps failing.
BAYMAX_MODEL=gemini-3.5-flash-lite
BAYMAX_FALLBACK_MODEL=

# "gemini" for real use, "fake" to try the app with no API key.
BAYMAX_LLM=gemini

# Browser origins allowed to call the API cross-origin. Leave empty for same-origin only.
BAYMAX_ALLOWED_ORIGINS=

# Set to 1 only when a trusted local reverse proxy is configured; otherwise leave off.
# X-Forwarded-For is ignored unless the direct peer is loopback.
BAYMAX_TRUSTED_PROXY=0

# Number of pre-migration SQLite backups to keep.
BAYMAX_BACKUP_KEEP=7

# Session summaries currently retain topics only.
BAYMAX_SUMMARY_DETAIL=topics

# Closed-friends mode: 0 hides and locks in-app data controls; 1 restores the old controls for tests/Codespaces.
BAYMAX_USER_CONTROLS=0

# Network. Keep 127.0.0.1 unless you put HTTPS in front (see README).
BAYMAX_HOST=127.0.0.1
BAYMAX_PORT=8080

# Limits and safety text
BAYMAX_MAX_PER_DAY=200
BAYMAX_EMERGENCY_HINT=your local emergency number
BAYMAX_DATA_DIR=data
